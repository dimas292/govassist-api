# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
STORAGE_DIR=uploads
AUDIO_MAX_BYTES=20971520
IMAGE_MAX_BYTES=5242880

# Admin session (use long random values in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_ACTOR_ID=1
ADMIN_SESSION_HOURS=8

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgresql:password@localhost:5432/govassist_db?schema=public"

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7
