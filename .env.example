# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging: debug, info, warn, error, or silent
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
TICKET_CREATE_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# Media storage: local for development, r2 for Cloudflare R2, s3 for other providers
STORAGE_DRIVER=local
STORAGE_DIR=uploads
AUDIO_MAX_BYTES=20971520
IMAGE_MAX_BYTES=5242880

# S3-compatible storage (required when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Cloudflare R2 (required when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_BUCKET=govassist-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Admin session (use long random values in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_ACTOR_ID=1
ADMIN_SESSION_HOURS=8

# Admin session cookie across origins
# ADMIN_COOKIE_SAME_SITE: lax | strict | none. Use "none" when the web app
# and the API run on different sites (cross-site), otherwise the browser
# drops the cookie on fetch requests after login.
# sameSite=none forces secure=true, so the API must be served over HTTPS.
ADMIN_COOKIE_SAME_SITE=lax
# ADMIN_COOKIE_SECURE: force the Secure flag. Defaults to true in production.
ADMIN_COOKIE_SECURE=false

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgresql:password@localhost:5432/govassist_db?schema=public"

# Report speech-to-text provider
# Available: whisper
SPEECH_TO_TEXT_PROVIDER=whisper

# Whisper API endpoint, for example a Railway deployment
WHISPER_ENDPOINT_URL=https://your-whisper-service.up.railway.app
WHISPER_API_TOKEN=
WHISPER_LANGUAGE=id
WHISPER_TIMEOUT_MS=60000

# Report decision provider
# Available: gemini, openrouter
REPORT_DECISION_PROVIDER=gemini
REPORT_DECISION_TIMEOUT_MS=30000
REPORT_DECISION_MAX_TOKENS=2048
REPORT_DECISION_TEMPERATURE=0.1

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7
GEMINI_TIMEOUT_MS=30000

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=GovAssist
